#!/bin/sh
set -eu

esp_uuid=$(findmnt -no UUID /efi 2>/dev/null || true)
[ -n "$esp_uuid" ] || exit 0

uki=/efi/EFI/Linux/arch-linux-zen.efi
[ -f "$uki" ] || exit 0

sections=$(objdump -h "$uki" 2>/dev/null || true)
for section in .linux .initrd .osrel .cmdline; do
    printf '%s\n' "$sections" | awk -v wanted="$section" \
        '$2 == wanted && $3 != "00000000" { found=1 } END { exit !found }' || exit 0
done

cat <<EOF
menuentry 'Arch Linux' --class arch --class gnu-linux --class os --id 'arch-uki-zen' {
    savedefault
    insmod part_gpt
    insmod fat
    insmod chain
    search --no-floppy --fs-uuid --set=root $esp_uuid
    chainloader /EFI/Linux/arch-linux-zen.efi
}
EOF
