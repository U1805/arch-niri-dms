#!/usr/bin/env bash
set -euo pipefail
# Trace application-owned user files, rank candidates, and optionally remove them.

apply=false
remove_package=false
keep_alive=false
seconds=10
usage() {
  printf 'Usage: pacrrr [--apply] [--remove-package] [-k|--keep-alive] [-t|--timeout SECONDS] COMMAND [ARG ...]\n'
  printf 'Default mode traces and reports selections without deleting anything.\n'
}
require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'pacrrr: missing dependency: %s\nInstall it with:\n  sudo pacman -S --needed %s\n' "$1" "$2" >&2
    exit 127
  }
}
while (($#)); do
  case $1 in
    --apply) apply=true; shift;;
    --remove-package) remove_package=true; shift;;
    -k|--keep-alive) keep_alive=true; shift;;
    -t|--timeout) [[ ${2:-} =~ ^[1-9][0-9]*$ ]] || { usage >&2; exit 2; }; seconds=$2; shift 2;;
    -h|--help) usage; exit 0;;
    --) shift; break;;
    -*) usage >&2; exit 2;;
    *) break;;
  esac
done
(($#)) || { usage >&2; exit 2; }
require_command strace strace
require_command fzf fzf
require_command awk gawk
if $remove_package; then
  require_command pacman pacman
  require_command sudo sudo
fi

app_cmd=$1
app_path=$(command -v "$app_cmd" 2>/dev/null || true)
[[ -n $app_path && -x $app_path ]] || {
  printf 'pacrrr: command or executable not found: %s\n' "$app_cmd" >&2
  exit 1
}
app_path=$(readlink -f -- "$app_path")
app_name=$(basename -- "$app_path" | tr '[:upper:]' '[:lower:]')
app_name=${app_name#linux}
app_name=${app_name%-bin}
app_name=${app_name%-git}
app_name=${app_name%.appimage}

tmp=$(mktemp -d /tmp/arch-niri-pacrrr.XXXXXX)
trace=$tmp/trace
trace_pid=
cleanup() {
  if [[ -n ${trace_pid:-} ]] && kill -0 "$trace_pid" 2>/dev/null; then
    kill -TERM -- -"$trace_pid" 2>/dev/null || true
  fi
  rm -rf -- "$tmp"
}
trap cleanup EXIT INT TERM

extract_candidates() {
  awk -v home="$HOME/" '
    {while (match($0,/"[^"]+"/)) {
      p=substr($0,RSTART+1,RLENGTH-2); $0=substr($0,RSTART+RLENGTH)
      if (index(p,home)!=1) continue
      r=substr(p,length(home)+1); n=split(r,a,"/")
      if (a[1]==".config" || a[1]==".cache") {if(n>1) print home a[1] "/" a[2]}
      else if(a[1]==".local" && (a[2]=="share" || a[2]=="state")) {if(n>2) print home a[1] "/" a[2] "/" a[3]}
      else if(substr(a[1],1,1)=="." && a[1]!=".local") print home a[1]
      else print p
    }}' "$trace" | sort -u
}

set -m
env APPIMAGE_EXTRACT_AND_RUN=1 strace -f -e trace=%file -o "$trace" -- "$@" >/dev/null 2>&1 &
trace_pid=$!
set +m
printf '\033[1;36m[*]\033[0m Tracing: \033[1;33m%s\033[0m (PGID %s)\n' "$*" "$trace_pid"
if $keep_alive; then
  printf 'Close the application or press Enter to finish tracing.\n'
  while kill -0 "$trace_pid" 2>/dev/null; do read -r -t 1 && break || true; done
else
  printf 'Collecting configuration access; automatic limit %ss. Press Enter to finish early.\n' "$seconds"
  previous=0
  stable=0
  for ((tick=0; tick<seconds; tick++)); do
    read -r -t 1 && break || true
    kill -0 "$trace_pid" 2>/dev/null || break
    current=$(extract_candidates | wc -l)
    if ((current > 0 && current == previous)); then
      stable=$((stable + 1))
      ((stable >= 2)) && break
    else
      stable=0
    fi
    previous=$current
  done
fi
if kill -0 "$trace_pid" 2>/dev/null; then
  kill -TERM -- -"$trace_pid" 2>/dev/null || true
  sleep 0.3
  kill -KILL -- -"$trace_pid" 2>/dev/null || true
fi
wait "$trace_pid" 2>/dev/null || true
trace_pid=

extract_candidates >"$tmp/raw"
generic_re='^(fontconfig|dconf|mime|gtk-[0-9.]*|qt[0-9]*|pulse|pipewire|systemd|dbus-[0-9]*|xorg|gvfs|ibus|fcitx[0-9]*|mozc|glib-[0-9.]*|mesa_shader_cache|radv_builtin_shaders|gstreamer-[0-9.]*|thumbnails|applications|icons|fonts|Trash|gvfs-metadata|flatpak|themes|vulkan)$'
: >"$tmp/filtered"
while IFS= read -r path; do
  [[ -e $path && $path == "$HOME"/* && $path != "$HOME" ]] || continue
  case $path in
    "$HOME/.ssh"|"$HOME/.gnupg"|"$HOME/.dbus"|"$HOME/.bash_history"|"$HOME/.zsh_history"|"$HOME/.bashrc"|"$HOME/.zshrc"|"$HOME/.profile"|"$HOME/.Xauthority"|"$HOME/.ICEauthority") continue;;
  esac
  base=$(basename -- "$path" | tr '[:upper:]' '[:lower:]')
  if [[ $base =~ $generic_re && $app_name != *"$base"* ]]; then continue; fi
  printf '%s\n' "$path" >>"$tmp/filtered"
done <"$tmp/raw"

awk -v app="$app_name" -v home="$HOME" '
  {score=100; n=split($0,a,"/"); base=tolower(a[n]);
   if(length(app)>1 && (index(base,app)>0 || index(app,base)>0)) score-=50;
   if(index($0,home "/.config/")==1 || index($0,home "/.local/share/")==1) score-=30;
   else if(index($0,home "/.cache/")==1 || index($0,home "/.local/state/")==1) score-=20;
   else if($0 ~ ("^" home "/\\.[^/]+$")) score-=10;
   print score "\t" $0}' "$tmp/filtered" | sort -n -k1,1 | cut -f2- >"$tmp/candidates"

[[ -s $tmp/candidates ]] || { printf '\033[1;32m[+]\033[0m No user configuration candidates found.\n'; exit 0; }
set +e
fzf --multi --height=40% --layout=reverse \
  --prompt='Tab: select | Enter: confirm | Esc: exit > ' \
  <"$tmp/candidates" >"$tmp/selected"
fzf_status=$?
set -e
[[ $fzf_status -eq 0 && -s $tmp/selected ]] || exit 0
mapfile -t selected <"$tmp/selected"
printf 'Selected paths:\n'; printf '  %s\n' "${selected[@]}"
$apply || { printf '\nPreview only. Re-run with --apply to delete selected paths.\n'; exit 0; }
read -r -p 'Delete exactly these paths? Type DELETE: ' answer
[[ $answer == DELETE ]] || exit 0
for path in "${selected[@]}"; do
  [[ $path == "$HOME"/* && $path != "$HOME" && -e $path ]] || {
    printf 'Rejected unsafe path: %s\n' "$path" >&2
    exit 1
  }
  rm -rf -- "$path"
  printf '\033[31m[-]\033[0m Deleted: %s\n' "$path"
done

$remove_package || exit 0
if [[ ${app_path,,} == *.appimage ]]; then
  read -r -p "Also delete AppImage $app_path? [y/N] " answer
  [[ $answer =~ ^[Yy]$ ]] && rm -f -- "$app_path"
  exit 0
fi
package=$(pacman -Qqo "$app_path" 2>/dev/null || true)
if [[ -z $package ]]; then
  mapfile -t matches < <(pacman -Qsq "$app_cmd" 2>/dev/null || true)
  if ((${#matches[@]} == 1)); then package=${matches[0]}
  elif ((${#matches[@]} > 1)); then
    package=$(printf '%s\n' "${matches[@]}" | fzf --height=40% --layout=reverse \
      --prompt='Select package to remove > ' || true)
  fi
fi
[[ -n $package ]] || { printf 'No installed package matched %s.\n' "$app_cmd"; exit 0; }
read -r -p "Also remove package $package? [y/N] " answer
[[ $answer =~ ^[Yy]$ ]] && sudo pacman -Rns -- "$package"
