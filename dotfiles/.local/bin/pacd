#!/usr/bin/env bash
set -euo pipefail
# Fuzzy-select installed packages and pass them to downgrade.

query=()
usage() { printf 'Usage: pacd [QUERY]\nThe argument is an initial FZF query, not a direct package target.\n'; }
require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'pacd: missing dependency: %s\nInstall it with:\n  sudo pacman -S --needed %s\n' "$1" "$2" >&2
    exit 127
  }
}
while (($#)); do
  case $1 in
    -h|--help) usage; exit 0;;
    -*) usage >&2; exit 2;;
    *) query+=("$1");;
  esac
  shift
done
require_command pacman pacman
require_command downgrade downgrade
require_command sudo sudo
require_command fzf fzf

if [[ ${LC_ALL:-${LC_MESSAGES:-${LANG:-}}} == *zh* ]]; then
  header='Tab:多选 | Enter:降级 | Esc:退出'
  selected_label='准备降级：'
  warning='[依赖危险警告] 降级核心库可能破坏系统！'
else
  header='Tab:Multi-Select | Enter:Downgrade | Esc:Exit'
  selected_label='Preparing to downgrade:'
  warning='[DANGER] Downgrading core libraries can break the system!'
fi

tmp=$(mktemp -d /tmp/arch-niri-pacd.XXXXXX)
generator_pid=
cleanup() {
  [[ -z ${generator_pid:-} ]] || kill "$generator_pid" 2>/dev/null || true
  rm -rf -- "$tmp"
}
trap cleanup EXIT INT TERM
mkfifo "$tmp/list"
(
pacman --color=never -Sl >"$tmp/sync"
pacman --color=never -Q | awk 'NR==FNR {if (!($2 in repo)) repo[$2]=$1; next}
  {source=(($1 in repo) ? repo[$1] : "aur"); color=(source=="aur" ? "\033[35m" : "\033[34m");
   printf "%s%s\033[0m", color, source; for(i=length(source);i<16;i++) printf " ";
   printf "%-35s %s\n", $1, $2}' "$tmp/sync" -
) >"$tmp/list" &
generator_pid=$!

set +e
fzf --multi --ansi --nth=2 \
  --preview 'pacman --color=always -Qi {2}' --preview-window=down:55%:wrap \
  --height=95% --layout=reverse --border --tiebreak=index --header "$header" \
  --query "${query[*]:-}" <"$tmp/list" >"$tmp/selected"
status=$?
set -e
wait "$generator_pid" 2>/dev/null || true
generator_pid=
[[ $status -eq 0 && -s $tmp/selected ]] || exit 0

packages=()
while IFS= read -r line; do
  clean=$(sed $'s/\033\[[0-9;]*[[:alpha:]]//g' <<<"$line")
  read -r _ package _ <<<"$clean"
  [[ -n $package ]] && packages+=("$package")
done <"$tmp/selected"
((${#packages[@]})) || exit 0
printf '\n\033[1;33m%s\033[0m %s\n' "$selected_label" "${packages[*]}"
printf '\033[1;31m%s\033[0m\n' "$warning"
exec sudo downgrade "${packages[@]}"
